# Copy to .env.local for local development, and add the same keys in your host's dashboard (e.g. Vercel).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# International format, digits only (e.g. 233241234567 or 14165551234). Used for the WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=registerednursehetty.ca@gmail.com
NEXT_PUBLIC_TIKTOK_HANDLE=stylenurse1
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hetty?retryWrites=true&w=majority

# --- Auth ---
# Long random string: `openssl rand -base64 48`
AUTH_SECRET=

# Used once by `npm run create-admin`
ADMIN_NAME=Harriet K
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Payments ---
# Paystack (Ghana: Mobile Money + cards in GHS) — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
# Stripe (international cards in CAD) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional; without it emails are logged to the server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hetty Global Academy <no-reply@yourdomain.com>"
# Where booking/contact notifications for Harriet are sent
ADMIN_NOTIFY_EMAIL=registerednursehetty.ca@gmail.com
